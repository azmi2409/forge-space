# forge-space config — copy to .env and fill in. Flat ${VAR:-default} only (Coolify-safe).
PORT=8080
DATABASE_PATH=./data/forge-space.db
STATIC_DIR=./web/dist
# Dev default. Set your real origin(s) before a public deploy.
CORS_ORIGINS=*

# Media (optional in dev — voice/video disabled when unset)
LIVEKIT_URL=
# Set real secrets before a public deploy (docker-compose falls back to devkey/devsecret).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
